{% endblock %}

{% block content %}
<main class="main-branch">
    <section class="branch-hero">
        <div class="container">
            <h1 class="page-title">{{ city }}</h1>
            <p class="branch-subtitle">
                {% if is_main_office %}
                Головний офіс та логістичний центр
                {% else %}
                Регіональне представництво
                {% endif %}
            </p>
        </div>
    </section>

    <section class="branch-content">
        <div class="container">
            <div class="branch-info">
                <h2>{{ city }} – серце нашої логістики</h2>
